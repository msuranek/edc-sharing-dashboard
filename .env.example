# EDC portal credentials.
# Copy this file to .env and fill in your own values.

EDC_USERNAME=
EDC_PASSWORD=

# Optional logical project identifier. Used in data/<project-code>/ and
# downloads/<project-code>/.
EDC_PROJECT_CODE=example

# Default EDC sharing group name. It must match the name shown in the EDC portal.
EDC_GROUP=

# Token required by the web UI/API when triggering downloads.
EDC_ADMIN_TOKEN=change-this-token

# Docker compose host binding.
# Use 127.0.0.1 when the app is behind Apache/Nginx/Caddy reverse proxy.
EDC_BIND=127.0.0.1
EDC_PORT=8333

# Local non-Docker Selenium settings, if needed.
# EDC_CHROME_BINARY=/path/to/chrome
# EDC_CHROMEDRIVER=/path/to/chromedriver
# EDC_CHROME_PROFILE=downloads/example/chrome-profile
# EDC_DOWNLOAD_DIR=data/example/default/raw
